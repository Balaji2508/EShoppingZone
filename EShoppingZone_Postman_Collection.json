{
  "info": {
    "_postman_id": "eshoppingzone-microservices-2026",
    "name": "EShoppingZone - Spring Boot Microservices",
    "description": "Complete Postman API Collection for EShoppingZone E-Commerce microservices ecosystem (API Gateway, Profile, Product, Cart, Order, Wallet, Notification).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication & Profiles",
      "item": [
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"customer123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profiles/login", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "login"] }
          }
        },
        {
          "name": "Merchant Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant@gmail.com\",\n  \"password\": \"merchant123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profiles/login", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "login"] }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"rahul123\",\n  \"phone\": \"9876543219\",\n  \"address\": \"789 Silicon Valley, Hyderabad\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profiles/register", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "register"] }
          }
        },
        {
          "name": "Get Profile by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/profiles/1", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "1"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Customer Updated\",\n  \"phone\": \"9998887770\",\n  \"address\": \"Flat 402, Green Avenue, Bangalore 560001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profiles/1", "host": ["{{baseUrl}}"], "path": ["api", "profiles", "1"] }
          }
        }
      ]
    },
    {
      "name": "2. Products Catalog (Public & Merchant)",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          }
        },
        {
          "name": "Search Products by Name",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/search?name=phone", "host": ["{{baseUrl}}"], "path": ["api", "products", "search"], "query": [{ "key": "name", "value": "phone" }] }
          }
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/products/category/Electronics", "host": ["{{baseUrl}}"], "path": ["api", "products", "category", "Electronics"] }
          }
        },
        {
          "name": "Add Product (Merchant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Gaming Mouse\",\n  \"description\": \"RGB Optical Gaming Mouse 16000 DPI\",\n  \"price\": 2999.0,\n  \"category\": \"Electronics\",\n  \"stockQuantity\": 40,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1527864550417-7fd91fc51a46?w=400\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro Max\",\n  \"description\": \"Apple iPhone 15 Pro Max 256GB Titanium\",\n  \"price\": 135000.0,\n  \"category\": \"Electronics\",\n  \"stockQuantity\": 12,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1695048133142-1a20484d2569?w=400\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/products/1", "host": ["{{baseUrl}}"], "path": ["api", "products", "1"] }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/products/10", "host": ["{{baseUrl}}"], "path": ["api", "products", "10"] }
          }
        }
      ]
    },
    {
      "name": "3. Cart Service",
      "item": [
        {
          "name": "Get Cart by User ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cart/1", "host": ["{{baseUrl}}"], "path": ["api", "cart", "1"] }
          }
        },
        {
          "name": "Add Product to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 4,\n  \"productName\": \"Java Programming Masterclass\",\n  \"price\": 899.0,\n  \"quantity\": 2,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1532012164546-f432f2e3edd4?w=400\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/cart/1/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "1", "add"] }
          }
        },
        {
          "name": "Update Cart Item Quantity",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/cart/1/item/4", "host": ["{{baseUrl}}"], "path": ["api", "cart", "1", "item", "4"] }
          }
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/cart/1/item/4", "host": ["{{baseUrl}}"], "path": ["api", "cart", "1", "item", "4"] }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/cart/1/clear", "host": ["{{baseUrl}}"], "path": ["api", "cart", "1", "clear"] }
          }
        }
      ]
    },
    {
      "name": "4. Wallet Service",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/wallet/1", "host": ["{{baseUrl}}"], "path": ["api", "wallet", "1"] }
          }
        },
        {
          "name": "Add Money to Wallet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/wallet/1/add-money", "host": ["{{baseUrl}}"], "path": ["api", "wallet", "1", "add-money"] }
          }
        },
        {
          "name": "Make Wallet Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1500.0,\n  \"description\": \"Direct Wallet Payment Test\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/wallet/1/pay", "host": ["{{baseUrl}}"], "path": ["api", "wallet", "1", "pay"] }
          }
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/wallet/1/transactions", "host": ["{{baseUrl}}"], "path": ["api", "wallet", "1", "transactions"] }
          }
        }
      ]
    },
    {
      "name": "5. Order Service",
      "item": [
        {
          "name": "Create Order (WALLET Checkout)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"paymentMethod\": \"WALLET\",\n  \"shippingAddress\": \"123 Main Street, Bangalore 560001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Create Order (Cash on Delivery - COD)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"paymentMethod\": \"COD\",\n  \"shippingAddress\": \"123 Main Street, Bangalore 560001\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders/1", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1"] }
          }
        },
        {
          "name": "Get Orders by User ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders/user/1", "host": ["{{baseUrl}}"], "path": ["api", "orders", "user", "1"] }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderStatus\": \"SHIPPED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders/1/status", "host": ["{{baseUrl}}"], "path": ["api", "orders", "1", "status"] }
          }
        }
      ]
    },
    {
      "name": "6. Notifications & RabbitMQ",
      "item": [
        {
          "name": "Get Received Notifications",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ]
}
